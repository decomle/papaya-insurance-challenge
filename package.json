{
  "name": "claims-workflow-orchestrator",
  "version": "1.0.0",
  "private": true,
  "description": "Configurable claims lifecycle workflow engine",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dev": "vite --config frontend/vite.config.mts",
