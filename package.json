{
  "name": "claims-workflow-orchestrator",
  "version": "1.0.0",
  "private": true,
  "description": "Configurable claims lifecycle workflow engine",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dev": "concurrently -k -n api,web \"tsx watch backend/src/server.ts\" \"vite --config frontend/vite.config.mts\"",
    "dev:backend": "tsx watch backend/src/server.ts",
    "dev:frontend": "vite --config frontend/vite.config.mts",
    "build:frontend": "vite build --config frontend/vite.config.mts",
    "typecheck:frontend": "tsc --project frontend/tsconfig.json",
    "preview": "vite preview --config frontend/vite.config.mts",
    "start:backend": "node backend/dist/server.js"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "fastify": "^5.12.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
